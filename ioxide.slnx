    <Project Path="Playground/Http2/ManagedStreamedBoth/Playground.Http2.ManagedStreamedBoth.csproj" />
    <Project Path="Playground/Http2/Tls/Playground.Http2.Tls.csproj" />
    <Project Path="Playground/Http2/SslStream/Playground.Http2.SslStream.csproj" />
    <Project Path="Playground/Http2/Sni/Playground.Http2.Sni.csproj" />
