    <Project Path="Playground/Tls/MtlsOpenSslPipes/Playground.Tls.MtlsOpenSslPipes.csproj" />
    <Project Path="Playground/Tls/MultiPort/Playground.Tls.MultiPort.csproj" />
    <Project Path="Playground/Tls/OpenSsl/Playground.Tls.OpenSsl.csproj" />
    <Project Path="Playground/Tls/OpenSslPipes/Playground.Tls.OpenSslPipes.csproj" />
    <Project Path="Playground/Tls/SslStream/Playground.Tls.SslStream.csproj" />
    <Project Path="Playground/Tls/Sni/Playground.Tls.Sni.csproj" />
  </Folder>

  <Folder Name="/apps/playground/http2/">
    <Project Path="Playground/Http2/ManagedBuffered/Playground.Http2.ManagedBuffered.csproj" />
    <Project Path="Playground/Http2/Nghttp2Buffered/Playground.Http2.Nghttp2Buffered.csproj" />
    <Project Path="Playground/Http2/Nghttp2Response/Playground.Http2.Nghttp2Response.csproj" />
