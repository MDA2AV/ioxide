<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ioxide</RootNamespace>

    <PackageId>ioxide</PackageId>
    <Version>0.17.340</Version>
    <Authors>MDA2AV</Authors>
    <Description>A shared-nothing io_uring runtime for .NET: one ring per reactor thread, inline completions, no system dependencies. The engine - reactor, connection, and the IRingHost client seam. Includes TLS termination on a bundled BoringSSL (libioxide_boringssl.so): the handshake driven over the ring, then optional kernel TLS (kTLS) offload, so handlers keep writing plaintext. kTLS needs the Linux tls module; nothing else does, and neither is loaded unless you use it.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://mda2av.github.io/ioxide/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MDA2AV/ioxide</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>io_uring;networking;tcp;server;linux;thread-per-core;reactor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- BoringSSL (built by scripts/build-boringssl-native.sh): packed into the nupkg's runtimes/ so
         consumers get it with no prerequisites, and copied next to the output for ProjectReference/dev
         runs so DllImport probing finds it. -->
    <None Include="runtimes/linux-x64/native/libioxide_boringssl.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/"
          CopyToOutputDirectory="PreserveNewest" Link="libioxide_boringssl.so" />
  </ItemGroup>

  <!--
    IoxideRuntime.Version is generated from the Version property above rather than written next to
    it in C#. A second literal has to be remembered on every release and was not: it read "0.0.17"
    against packages on 0.13.233, having gone untouched since the 0.0.x days (#224).

    Generated rather than read back off the assembly at runtime, because reflection over assembly
    attributes is exactly what Native AOT trims. This costs nothing at run time - it is a const, so
    it inlines - and cannot disagree with the Version above, which is the only thing a release edits.

    %3B is an escaped semicolon: MSBuild would otherwise read one as an item separator.
  -->
  <Target Name="GenerateVersionSource" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_IoxideVersionFile>$(IntermediateOutputPath)IoxideVersion.g.cs</_IoxideVersionFile>
    </PropertyGroup>

    <ItemGroup>
      <_IoxideVersionLines Include="// &lt;auto-generated /&gt;" />
      <_IoxideVersionLines Include="// Written by the GenerateVersionSource target in ioxide.csproj, from its Version property." />
      <_IoxideVersionLines Include="// Do not edit, and do not commit: it lives under obj/." />
      <_IoxideVersionLines Include="namespace ioxide%3B" />
      <_IoxideVersionLines Include="internal static class IoxideVersion" />
      <_IoxideVersionLines Include="{" />
      <_IoxideVersionLines Include="    public const string Value = &quot;$(Version)&quot;%3B" />
      <_IoxideVersionLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_IoxideVersionFile)" Lines="@(_IoxideVersionLines)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_IoxideVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
