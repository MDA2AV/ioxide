<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ioxide.ngtcp2</RootNamespace>

    <PackageId>ioxide.ngtcp2</PackageId>
    <Version>0.20.392</Version>
    <Authors>MDA2AV</Authors>
    <Description>QUIC engine for the ioxide io_uring runtime: ngtcp2 + picotls + BoringSSL's libcrypto bundled as a single self-contained native library with no system dependencies. Plugs into the reactor's QUIC transport via QuicConnection. Server side; engine bindings in progress.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://mda2av.github.io/ioxide/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MDA2AV/ioxide</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>io_uring;quic;http3;ngtcp2;picotls;linux;ioxide</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../../ioxide/ioxide.csproj" />

    <!-- The self-contained native bundle (built by scripts/build-ngtcp2-native.sh), one build per RID:
         packed into the nupkg's runtimes/ so consumers get it with no prerequisites, and the build
         machine's copied next to the output for ProjectReference/dev runs so DllImport probing finds it. -->
    <None Include="runtimes/linux-x64/native/libioxide_ngtcp2.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="runtimes/linux-arm64/native/libioxide_ngtcp2.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="runtimes/$(IoxideNativeRid)/native/libioxide_ngtcp2.so"
          CopyToOutputDirectory="PreserveNewest" Link="libioxide_ngtcp2.so" />
  </ItemGroup>

</Project>
